# ============================================
#  Zuik Frontend - Environment Configuration
# ============================================
#  Copy to .env.local (Vite loads it automatically):
#    cp .env.template .env.local
#
#  Uncomment ONE network block (TestNet, LocalNet, or MainNet).
#  Then fill in API keys at the bottom.
# ============================================


# ---------- TestNet (via Nodely free tier) ----------
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER=https://testnet-api.4160.nodely.dev
VITE_ALGOD_PORT=
VITE_ALGOD_NETWORK=testnet
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
VITE_INDEXER_PORT=


# ---------- LocalNet (uncomment to use) ----------
# VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# VITE_ALGOD_SERVER=http://localhost
# VITE_ALGOD_PORT=4001
# VITE_ALGOD_NETWORK=localnet
# VITE_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# VITE_INDEXER_SERVER=http://localhost
# VITE_INDEXER_PORT=8980
# VITE_KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# VITE_KMD_SERVER=http://localhost
# VITE_KMD_PORT=4002
# VITE_KMD_WALLET=unencrypted-default-wallet
# VITE_KMD_PASSWORD=


# Guardian (ZuikGuardian) - set after deploy in projects/Zuik-contracts for this network
# TestNet Guardian (ZuikGuardian) - update after redeploy
VITE_GUARDIAN_APP_ID=763727553
VITE_GUARDIAN_APP_ADDRESS=
# Max ASA risk score (0-100) for server agent workflows; mirrors Settings > Guardian slider
ZUIK_MAX_TOKEN_RISK=75

# ---------- MainNet (uncomment to use) ----------
# VITE_ALGOD_TOKEN=""
# VITE_ALGOD_SERVER=https://mainnet-api.4160.nodely.dev
# VITE_ALGOD_PORT=
# VITE_ALGOD_NETWORK=mainnet
# VITE_INDEXER_TOKEN=""
# VITE_INDEXER_SERVER=https://mainnet-idx.4160.nodely.dev
# VITE_INDEXER_PORT=


# ============================================
#  API Keys (fill in your values)
# ============================================

# Zuik backend server (AI proxy, market proxy, webhooks)
# Local: http://localhost:4030 (match projects/server PORT in .env)
VITE_SERVER_URL=http://localhost:4030

# Groq model name (API key lives on the server as GROQ_API_KEY)
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Supabase - Workflow persistence and dashboard
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Telegram Bot (optional - for Send Telegram notification block)
# VITE_TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_BOT_USERNAME=YourBotUsername

# Voice (optional). Leave empty in dev to use Vite proxy /api/voice -> port 3002.
# Production: set to your Railway URL when voice runs on the same host.
# VITE_VOICE_SERVER_URL=
