    "contract": {
        "name": "ZuikGuardian",
        "desc": "ZuikGuardian - on-chain policy store for funded agent sub-accounts.\n\nEnforcement model is an atomic transaction group:\n  [0] pay/axfer (sender = agent sub-account, signed by the server-held agent key)\n  [1] appl authorize_trade(pay) / authorize_asset_trade(spend)\n\nIf any assert here fails, the entire group reverts, so not even Zuik's server\ncan move funds outside the policy registered by the owner.",
        "methods": [
            {
                "name": "createApplication",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "bootstrap",
                "args": [
                    {
                        "type": "address",
                        "name": "agent"
                    },
                    {
                        "type": "uint64",
                        "name": "maxPerTradeMicroAlgos"
                    },
                    {
                        "type": "uint64",
                        "name": "dailyCapMicroAlgos"
                    },
                    {
                        "type": "uint64",
                        "name": "expiryRound"
                    },
                    {
                        "type": "uint64",
                        "name": "executionsRemaining"
                    },
                    {
                        "type": "uint64",
                        "name": "allowedAssetId"
                    },
                    {
                        "type": "uint64",
                        "name": "allowedDexAppId"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Owner registers (or re-registers) an agent policy. Boxes do not require opt-in,\nbut the app account must be funded for box MBR before the first box write."
            },
            {
                "name": "allowRecipient",
                "args": [
                    {
                        "type": "address",
                        "name": "agent"
                    },
                    {
                        "type": "address",
                        "name": "recipient"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Owner adds a recipient to the global allowlist."
            },
            {
                "name": "authorize_trade",
                "args": [
                    {
                        "type": "pay",
                        "name": "pay"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Atomic enforcement for an ALGO payment. Must be grouped with the payment\ntransaction immediately before this application call."
            },
            {
                "name": "authorize_asset_trade",
                "args": [
                    {
                        "type": "axfer",
                        "name": "spend"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Atomic enforcement for an ASA transfer. Must be grouped with the asset\ntransfer transaction immediately before this application call."
            },
            {
                "name": "emergency_stop",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "resume",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "getPolicy",
                "args": [
                    {
                        "type": "address",
                        "name": "agent"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "(uint64,uint64,uint64,uint64,uint64,uint64,uint64,uint64)"
                }
            },
            {
                "name": "isRecipientAllowed",
                "args": [
                    {
                        "type": "address",
                        "name": "recipient"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "bool"
                }
            },
            {
                "name": "isPausedState",
                "args": [],
                "readonly": true,
                "returns": {
                    "type": "bool"
                }
            }
        ],
        "networks": {}
    },
