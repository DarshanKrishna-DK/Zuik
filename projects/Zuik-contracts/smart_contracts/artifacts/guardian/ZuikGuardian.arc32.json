    "contract": {
        "name": "ZuikGuardian",
        "desc": "On-chain policy store for funded agent sub-accounts.\n\nEnforcement uses an atomic group:\n  [0] pay or axfer from the agent account\n  [1] authorize_trade(pay) or authorize_asset_trade(axfer)\n\nIf any check fails, the whole group reverts.",
        "methods": [
            {
                "name": "createApplication",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "bootstrap",
                "args": [
                    {
                        "type": "address",
                        "name": "agent"
                    },
                    {
                        "type": "uint64",
                        "name": "maxPerTradeMicroAlgos"
                    },
                    {
                        "type": "uint64",
                        "name": "dailyCapMicroAlgos"
                    },
                    {
                        "type": "uint64",
                        "name": "expiryRound"
                    },
                    {
                        "type": "uint64",
                        "name": "dailyExecutionsCap"
                    },
                    {
                        "type": "uint64",
                        "name": "allowedAssetId"
                    },
                    {
                        "type": "uint64",
                        "name": "allowedDexAppId"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Owner sets or updates an agent policy. Fund the app account for box MBR first."
            },
            {
                "name": "allowRecipient",
                "args": [
                    {
                        "type": "address",
                        "name": "agent"
                    },
                    {
                        "type": "address",
                        "name": "recipient"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Owner allowlists a recipient for payouts."
            },
            {
                "name": "authorize_trade",
                "args": [
                    {
                        "type": "pay",
                        "name": "pay"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Validates an ALGO payment in the txn group immediately before this call."
            },
            {
                "name": "authorize_asset_trade",
                "args": [
                    {
                        "type": "axfer",
                        "name": "spend"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Validates an ASA transfer in the txn group immediately before this call."
